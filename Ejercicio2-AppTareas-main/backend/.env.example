# =============================================================================
# List Website - variables de entorno del backend
# Copia este archivo como `.env` y rellena los valores.
# En Railway estas mismas claves se cargan en Variables del servicio.
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Base de datos MySQL (RNF-03) --------------------------------------------
# En Railway el servicio MySQL expone MYSQL_URL / MYSQL_PUBLIC_URL; si defines
# DATABASE_URL el backend la usa y omite las variables sueltas de abajo.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=list_website
# Railway exige TLS en la URL pública; en local déjalo en false.
DB_SSL=false

# --- Sesiones / JWT (NRF-03, NRF-05) -----------------------------------------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# --- Correo electrónico con Brevo (NRF-02, NRF-04, RNF-02) -------------------
# API key de Brevo (Panel → SMTP & API → API Keys). Si se deja vacía, el backend
# arranca igual y escribe los enlaces en consola (modo desarrollo).
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@listwebsite.com
MAIL_FROM_NAME=List Website

# --- Frontend ----------------------------------------------------------------
# Origen permitido por CORS y base de los enlaces enviados por correo.
FRONTEND_URL=http://localhost:4200

# --- Caducidad de enlaces (minutos) ------------------------------------------
VERIFICATION_TOKEN_TTL_MIN=1440
RESET_TOKEN_TTL_MIN=30
